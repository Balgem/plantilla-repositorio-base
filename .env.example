# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Clave de API de Gemini (se crea gratis en https://aistudio.google.com/apikey).
# El proyecto acepta los dos nombres: GEMINI_API_KEY (el del curso) o API_KEY (el que usé desde el Gate 1).
GEMINI_API_KEY=tu_clave_aqui

# Modelo de Gemini a usar (elegido en docs/decision-arquitectura.md)
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: clave para las huellas HMAC de los logs (src/privacidad.py).
# Si no la defines, se crea sola en logs/.clave_huellas la primera vez.
# CLAVE_HUELLAS=una_frase_larga_y_secreta
