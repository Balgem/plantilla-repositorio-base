# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Llave de API de Gemini (se crea gratis en https://aistudio.google.com/apikey)
API_KEY=tu_llave_aqui
# Modelo de Gemini a usar (elegido en docs/decision-arquitectura.md)
GEMINI_MODEL=gemini-3.5-flash-lite
